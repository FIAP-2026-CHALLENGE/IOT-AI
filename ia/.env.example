# Copie para .env e preencha. O .env nunca vai para o Git.
# Oracle da FIAP (mesmo schema da API .NET)
ORACLE_USER=rmXXXXXX
ORACLE_PASSWORD=sua_senha
ORACLE_DSN=oracle.fiap.com.br:1521/orcl

# Gemini (Google AI Studio > Get API key). Plano gratuito tem limite por minuto e por dia.
GEMINI_API_KEY=sua_chave
GEMINI_MODEL=gemini-3.5-flash

# Endereço da API de IA (usado pela interface e nas URLs das fotos)
API_URL=http://localhost:8000
