    {
        "id": "b3a1c2d4e5f60003",
        "type": "function",
        "z": "f465c0e220cfe9f3",
        "name": "Texto para o painel",
        "func": "// 201: triagem feita; outro código: mostra o erro da API (ex.: 404 animal não encontrado)\nif (msg.statusCode !== 201) {\n    msg.payload = `Erro ${msg.statusCode}: ${msg.payload && msg.payload.detail || 'API indisponível'}`;\n    return msg;\n}\nconst r = msg.payload;\nmsg.payload = `${r.nivel} · ${r.animal}\n\n${r.texto}`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1080,
