    {
        "id": "360cd85df71440ec",
        "type": "function",
        "z": "f465c0e220cfe9f3",
        "name": "Leitura → API",
        "func": "// Payload do ESP32: \"peso,animalId\" (ex.: \"8.4,1\").\n// O animalId é o ID do animal em T_CP_ANIMAIS (na prática, viria da tag RFID da coleira).\nconst [peso, animalId] = String(msg.payload).split(',').map(Number);\n\nif (!(peso > 0) || !Number.isInteger(animalId)) {\n    // balança vazia (0 kg) ou payload fora do formato: não vai para a IA\n    node.warn(`Leitura ignorada: ${msg.payload}`);\n    return [null, null];\n}\n\nreturn [\n    { payload: { animal_id: animalId, peso: peso } }, // saída 1: corpo do POST /leituras\n    { payload: peso }                                 // saída 2: número para o gráfico e o gauge\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 540,
        "wires": [
            [
                "b3a1c2d4e5f60001",
                "93dab3c1c3a5e980"
            ],
            [
                "2be598bb97e09d49",
                "6ac6601392025e3b"
            ]
        ]
    },
